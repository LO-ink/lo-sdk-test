{
  "name": "lo-sdk-test",
  "version": "0.4.19",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "npm run build:go -- --release && tsc --noEmit && vite build && node scripts/write-release.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "npm run build:go && node --import tsx --test test/*.test.*",
    "format:check": "prettier --check web server scripts test package.json tsconfig.json vite.config.ts index.html README.md .github deploy",
    "build:go": "node scripts/build-go.mjs",
    "test:container": "node scripts/check-container.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@lo-ink/miniapp-sdk": "0.20.3",
    "@lo-ink/bot-sdk": "0.4.2",
    "@lo-ink/adapter-lo": "0.23.2",
    "@lo-ink/adapter-lo-legacy": "0.1.3",
    "@lo-ink/adapter-webapp-compat": "0.19.3",
    "@lo-ink/bot-http-lo": "0.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LO-ink/lo-sdk-test.git"
  }
}
