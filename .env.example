# Server only. Copy to .env and chmod 600; never use VITE_* for secrets.
PORT=5407
LO_APP_ID=
LO_APP_KEY=
LO_BOT_TOKEN=
LO_APP_URL=
# Optional exact verified user ID allowlist (comma separated).
LO_TEST_USER_IDS=
# Optional public HTTPS origin; must match LO_APP_URL, byte for byte.
PUBLIC_ORIGIN=
# Legacy Secretary test settings. The native draft flow is retired.
# Only OWNER_ID retains owner isolation for the terminal 410 route.
# Do not stop other receivers or replay/delete existing state to re-enable it.
LO_SECRETARY_TEST_TOKEN=
LO_SECRETARY_TEST_OWNER_ID=
LO_SECRETARY_TEST_PEER_ID=
LO_SECRETARY_TEST_CONNECTION_ID=
LO_SECRETARY_TEST_STATE=/var/lib/lo-sdk-test/secretary.json
# Legacy value; it no longer enables polling.
LO_SECRETARY_TEST_EXCLUSIVE_POLL=false
